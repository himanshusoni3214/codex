APP_NAME="Natural Gem Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://naturalgem.com
SEO_SITE_NAME="Natural Gem Store"
SEO_DEFAULT_OG_IMAGE=/images/natural-gem-logo.svg
SEO_DEFAULT_OG_IMAGE_ID=
SEO_DEFAULT_META_DESCRIPTION="Shop certified natural gemstones in Canada with transparent CAD pricing, treatment disclosures, and documentation-first support."
SEO_ORGANIZATION_NAME="Natural Gem Store"
SEO_ADDRESS_LINE="Toronto"
SEO_CITY="Toronto"
SEO_PROVINCE="Ontario"
SEO_POSTAL_CODE=
SEO_COUNTRY=CA
SEO_PHONE="+1 (647) 555-0199"
SEO_EMAIL="hello@naturalgem.com"
SEO_SOCIAL_LINKS="https://www.instagram.com/naturalgem,https://www.facebook.com/naturalgem"
SEO_GEMSTONES_PER_PAGE=12
SEO_URL_REDIRECT_ENABLED=true
SEO_FORCE_HTTPS=true
SEO_CANONICAL_HOST=
SEO_STRIP_TRAILING_SLASH=true
SEO_NOINDEX_PARAMETERIZED=true
SEO_THIN_WARNING_PRODUCTS=3
SEO_THIN_MIN_CONTENT_CHARS=500

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naturalgem
DB_USERNAME=naturalgem
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

HORIZON_NAME=naturalgem
HORIZON_PATH=horizon
HORIZON_PREFIX=naturalgem_horizon:

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@naturalgem.com"
MAIL_FROM_NAME="Natural Gem Store"

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

TELESCOPE_ENABLED=false

VITE_APP_NAME="Natural Gem Store"
